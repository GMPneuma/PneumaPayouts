{
  "name": "pneuma-payouts",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "description": "A TypeScript Foundry VTT module.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "packageManager": "pnpm@11.19.0"
}
