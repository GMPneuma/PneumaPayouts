<form class="payout-inbox-form">
  {{#if isGM}}
    <label class="inbox-gm-actions">
      <input type="checkbox" data-enable-gm-actions />
      <span><strong>Enable GM controls for player actions</strong><small>Allows
          you to roll Humanity and acknowledge payouts on behalf of players.
          Disabled by default to prevent accidental actions.</small></span>
    </label>
  {{/if}}

  {{#unless hasItems}}
    <p class="inbox-empty"><i class="fas fa-check-circle"></i>
      Nothing is waiting for you.</p>
  {{/unless}}

  {{#if pendingRolls.length}}
    <section class="inbox-section">
      <h3><i class="fas fa-dice-d6"></i> Pending Humanity Rolls</h3>
      {{#each pendingRolls}}
        <article class="inbox-item">
          <div>
            <strong>{{actorName}} — {{actionLabel}} {{formula}}</strong>
            <p>{{description}}</p>
          </div>
          <button
            type="button"
            data-player-inbox-action
            data-roll-id="{{id}}"
            data-actor-id="{{actorId}}"
          >
            <i class="fas fa-dice-d6"></i>
            Roll
          </button>
        </article>
      {{/each}}
    </section>
  {{/if}}

  {{#if acknowledgments.length}}
    <section class="inbox-section">
      <h3><i class="fas fa-receipt"></i>
        {{#if isGM}}Payout Acknowledgments{{else}}Payouts Awaiting
          Acknowledgment{{/if}}</h3>
      {{#each acknowledgments}}
        <article class="inbox-item">
          <div>
            <strong>{{userName}} — {{sessionLabel}}</strong>
            <p>{{actorName}}</p>
            <ul class="inbox-awards">
              {{#each awards}}
                <li>
                  {{#if img}}<img src="{{img}}" alt="" />{{/if}}
                  <span>{{text}}</span>
                </li>
              {{/each}}
            </ul>
          </div>
          <button
            type="button"
            data-player-inbox-action
            data-ack-id="{{id}}"
            data-user-id="{{userId}}"
          >
            <i class="fas fa-check"></i>
            Acknowledge
          </button>
        </article>
      {{/each}}
    </section>
  {{/if}}
</form>