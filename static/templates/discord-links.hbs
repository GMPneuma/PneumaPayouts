<form class="discord-links-form" autocomplete="off">
  <p>
    Link each Foundry player to either their Discord User ID or an individual
    Discord Role ID. An individual role should be assigned only to that player;
    shared roles mention everyone who has the role. In Discord, enable
    <b>Developer Mode</b>, then right-click the user or role and copy its ID.
  </p>

  <div class="discord-links-list">
    <label class="discord-crew-link">
      <strong>Everyone / Whole Crew</strong>
      <span>Role ID only</span>
      <input
        type="text"
        inputmode="numeric"
        name="ids.__everyone__"
        value="{{crewRoleId}}"
        placeholder="Whole-crew Discord role ID"
      />
    </label>
    {{#each players}}
      <label>
        <strong>{{userName}}</strong>
        <select
          name="kinds.{{userId}}"
          aria-label="Discord mention type"
          data-mention-kind
          data-selected="{{mentionKind}}"
        >
          <option value="user">User ID</option>
          <option value="role">Individual Role ID</option>
        </select>
        <input
          type="text"
          inputmode="numeric"
          name="ids.{{userId}}"
          value="{{discordId}}"
          placeholder="Discord user or role ID"
        />
      </label>
    {{else}}
      <p>No player accounts exist in this world.</p>
    {{/each}}
  </div>

  <button type="submit"><i class="fas fa-save"></i> Save Discord Links</button>
</form>