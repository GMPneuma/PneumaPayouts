<form class="payout-form" autocomplete="off">
  <nav class="wizard-steps" aria-label="Payout steps">
    <span
      class="wizard-step wizard-step--active"
      data-step-indicator="participants"
    ><b>1</b> Participants</span>
    <i class="fas fa-chevron-right" aria-hidden="true"></i>
    <span class="wizard-step" data-step-indicator="rewards"><b>2</b>
      Rewards</span>
  </nav>

  <section data-step-panel="participants">
    <header class="payout-heading">
      <p>Select the players and characters who participated in this session.</p>

      <div class="payout-metadata">
        <label>
          <span>Session label</span>
          <input
            type="text"
            name="sessionLabel"
            placeholder="Session name or number"
            required
          />
        </label>

        <label>
          <span>Notes</span>
          <textarea
            name="notes"
            rows="2"
            placeholder="Optional payout notes"
          ></textarea>
        </label>
      </div>
    </header>

    <section class="participant-list" aria-label="Session participants">
      {{#each players}}
        <article
          class="participant {{eligibilityClass}}"
          data-player-row
          data-user-id="{{userId}}"
        >
          <header class="participant-header">
            <label class="participant-toggle">
              <input
                type="checkbox"
                name="userIds"
                value="{{userId}}"
                data-user-toggle
                data-selected="{{selected}}"
                data-eligible="{{eligible}}"
              />
              <strong>{{userName}}</strong>
            </label>

            {{#if defaultActor}}
              <label class="actor-option actor-option--default">
                <input
                  type="checkbox"
                  name="actorIds"
                  value="{{defaultActor.actorId}}"
                  data-actor-toggle
                  data-actor-id="{{defaultActor.actorId}}"
                  data-actor-name="{{defaultActor.actorName}}"
                  data-primary="true"
                  data-selected="true"
                />
                <span>{{defaultActor.actorName}}</span>
                {{#if defaultActor.shared}}<span
                    class="tag tag--warning"
                  >Shared</span>{{/if}}
              </label>
            {{else}}
              <span class="empty-actors" title="{{warningText}}">No eligible
                Actor</span>
            {{/if}}

            {{#if hasOtherActors}}
              <button
                type="button"
                class="show-other-actors"
                data-show-other-actors
                aria-expanded="false"
              >Show other actors</button>
            {{/if}}

            <span class="presence {{presenceClass}}" title="{{presenceLabel}}">
              <i class="fas fa-circle" aria-hidden="true"></i>
            </span>
          </header>

          {{#if hasOtherActors}}
            <div class="other-actors" data-other-actors hidden>
              {{#each otherActors}}
                <label class="actor-option">
                  <input
                    type="checkbox"
                    name="actorIds"
                    value="{{actorId}}"
                    data-actor-toggle
                    data-actor-id="{{actorId}}"
                    data-actor-name="{{actorName}}"
                    data-primary="false"
                    data-selected="false"
                  />
                  <span>{{actorName}}</span>
                  {{#if shared}}<span
                      class="tag tag--warning"
                    >Shared</span>{{/if}}
                </label>
              {{/each}}
            </div>
          {{/if}}
        </article>
      {{else}}
        <p class="empty-players">No player accounts exist in this world.</p>
      {{/each}}
    </section>

    <footer class="payout-footer">
      <span data-selection-summary></span>
      <button type="button" class="wizard-button" data-next-step>Next
        <i class="fas fa-chevron-right"></i></button>
    </footer>
  </section>

  <section data-step-panel="rewards" hidden>
    <div class="reward-layout">
      <aside class="reward-context">
        <section>
          <span class="eyebrow">Session</span>
          <strong class="session-name" data-session-summary></strong>
        </section>

        <section class="recipient-summary">
          <span class="eyebrow">Recipients</span>
          <ul data-recipient-list></ul>
        </section>
      </aside>

      <fieldset class="group-rewards">
        <legend>Group payout</legend>
        <p>Each selected Actor receives these amounts.</p>

        <div class="reward-fields">
          <label class="reward-field">
            <span><i class="fas fa-coins"></i> Money</span>
            <input type="number" name="groupMoney" value="0" step="1" />
          </label>

          <label class="reward-field">
            <span><i class="fas fa-graduation-cap"></i> IP</span>
            <input type="number" name="groupIp" value="0" step="1" />
          </label>

          <div class="reward-field" data-humanity-field>
            <span><i class="fas fa-heart"></i> Humanity Gain</span>
            <div class="humanity-inputs">
              <input
                type="number"
                name="groupHumanityGainManual"
                value="0"
                min="0"
                step="1"
                aria-label="Manual Humanity Gain"
                data-humanity-manual
              />
              <span>or</span>
              <select
                name="groupHumanityGainDice"
                aria-label="Humanity Gain dice"
                data-humanity-mode
              >
                <option value="manual">Manual</option>
                <option value="1d6">1d6</option>
                <option value="2d6">2d6</option>
                <option value="3d6">3d6</option>
                <option value="4d6">4d6</option>
              </select>
            </div>
          </div>

          <div class="reward-field" data-humanity-field>
            <span><i class="fas fa-heart-crack"></i> Humanity Loss</span>
            <div class="humanity-inputs">
              <input
                type="number"
                name="groupHumanityLossManual"
                value="0"
                min="0"
                step="1"
                aria-label="Manual Humanity Loss"
                data-humanity-manual
              />
              <span>or</span>
              <select
                name="groupHumanityLossDice"
                aria-label="Humanity Loss dice"
                data-humanity-mode
              >
                <option value="manual">Manual</option>
                <option value="1d6">1d6</option>
                <option value="2d6">2d6</option>
                <option value="3d6">3d6</option>
                <option value="4d6">4d6</option>
              </select>
            </div>
          </div>
        </div>
      </fieldset>
    </div>

    <section class="individual-rewards">
      <header>
        <div>
          <h3>Individual payouts</h3>
          <p>Additional rewards applied only to the named recipient.</p>
        </div>
      </header>

      <div class="individual-payouts" data-individual-payouts></div>

      <template data-individual-row-template>
        <article class="individual-row" data-individual-row>
          <strong data-individual-actor-name></strong>

          <label class="individual-field individual-field--money">
            <span>Money</span>
            <input
              type="number"
              value="0"
              step="1"
              data-individual-field="money"
            />
          </label>

          <label class="individual-field">
            <span>IP</span>
            <span class="amount-reason">
              <input
                type="number"
                value="0"
                step="1"
                aria-label="IP amount"
                data-individual-field="ip"
              />
              <input
                type="text"
                placeholder="Reason"
                aria-label="IP reason"
                data-individual-field="ipReason"
              />
            </span>
          </label>

          <label class="individual-field">
            <span>Humanity Gain</span>
            <span class="amount-reason">
              <input
                type="number"
                value="0"
                min="0"
                step="1"
                aria-label="Humanity Gain amount"
                data-individual-field="humanityGain"
              />
              <input
                type="text"
                placeholder="Reason"
                aria-label="Humanity Gain reason"
                data-individual-field="humanityGainReason"
              />
            </span>
          </label>

          <label class="individual-field">
            <span>Humanity Loss</span>
            <span class="amount-reason">
              <input
                type="number"
                value="0"
                min="0"
                step="1"
                aria-label="Humanity Loss amount"
                data-individual-field="humanityLoss"
              />
              <input
                type="text"
                placeholder="Reason"
                aria-label="Humanity Loss reason"
                data-individual-field="humanityLossReason"
              />
            </span>
          </label>

          <label class="individual-field">
            <span>New Reputation</span>
            <span class="amount-reason">
              <input
                type="number"
                min="0"
                step="1"
                placeholder="—"
                aria-label="New Reputation value"
                data-individual-field="reputation"
              />
              <input
                type="text"
                placeholder="Reason"
                aria-label="Reputation reason"
                data-individual-field="reputationReason"
              />
            </span>
          </label>
        </article>
      </template>
    </section>

    <footer class="payout-footer">
      <button type="button" class="wizard-button" data-previous-step><i
          class="fas fa-chevron-left"
        ></i>
        Back</button>
      <button type="button" class="wizard-button" disabled title="Coming next">
        Preview payout
        <i class="fas fa-magnifying-glass"></i>
      </button>
    </footer>
  </section>
</form>