<form class="payout-form" autocomplete="off">
  <header class="payout-heading">
    <p>Select the players and characters who participated in this session.</p>

    <div class="payout-metadata">
      <label>
        <span>Session label</span>
        <input
          type="text"
          name="sessionLabel"
          placeholder="Session name or number"
          required
        />
      </label>

      <label>
        <span>Notes</span>
        <textarea
          name="notes"
          rows="2"
          placeholder="Optional payout notes"
        ></textarea>
      </label>
    </div>
  </header>

  <section class="participant-list" aria-label="Session participants">
    {{#each players}}
      <article
        class="participant {{eligibilityClass}}"
        data-player-row
        data-user-id="{{userId}}"
      >
        <header class="participant-header">
          <label class="participant-toggle">
            <input
              type="checkbox"
              name="userIds"
              value="{{userId}}"
              data-user-toggle
              data-selected="{{selected}}"
              data-eligible="{{eligible}}"
            />
            <strong>{{userName}}</strong>
          </label>

          {{#if defaultActor}}
            <label class="actor-option actor-option--default">
              <input
                type="checkbox"
                name="actorIds"
                value="{{defaultActor.actorId}}"
                data-actor-toggle
                data-actor-id="{{defaultActor.actorId}}"
                data-primary="true"
                data-selected="true"
              />
              <span>{{defaultActor.actorName}}</span>
              {{#if defaultActor.shared}}<span
                  class="tag tag--warning"
                >Shared</span>{{/if}}
            </label>
          {{else}}
            <span class="empty-actors" title="{{warningText}}">No eligible Actor</span>
          {{/if}}

          {{#if hasOtherActors}}
            <button
              type="button"
              class="show-other-actors"
              data-show-other-actors
              aria-expanded="false"
            >Show other actors</button>
          {{/if}}

          <span class="presence {{presenceClass}}" title="{{presenceLabel}}">
            <i class="fas fa-circle" aria-hidden="true"></i>
          </span>
        </header>

        {{#if hasOtherActors}}
          <div class="other-actors" data-other-actors hidden>
            {{#each otherActors}}
              <label class="actor-option">
                <input
                  type="checkbox"
                  name="actorIds"
                  value="{{actorId}}"
                  data-actor-toggle
                  data-actor-id="{{actorId}}"
                  data-primary="false"
                  data-selected="false"
                />
                <span>{{actorName}}</span>
                {{#if shared}}<span
                    class="tag tag--warning"
                  >Shared</span>{{/if}}
              </label>
            {{/each}}
          </div>
        {{/if}}
      </article>
    {{else}}
      <p class="empty-players">No player accounts exist in this world.</p>
    {{/each}}
  </section>

  <footer class="payout-footer">
    <span data-selection-summary></span>
    <span class="next-step"><i class="fas fa-info-circle"></i>
      Reward fields are added next.</span>
  </footer>
</form>